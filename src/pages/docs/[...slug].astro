---
// One page per Markdown file in src/content/docs.
import { getCollection, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { sectionName, type Doc as Entry } from '../../data/docs';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props as { doc: Entry };
const { Content } = await render(doc);
---

<Doc title={doc.data.title} description={doc.data.description} inscription={sectionName(doc.data.section)}>
  <Content />
</Doc>
