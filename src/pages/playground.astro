---
// The playground: the core showcase, moved into the site. Every axis live, with
// an index to its sections. The index is built from the same list the page
// renders, so it never links to a section that is not here.
import Base from '../layouts/Base.astro';
import ComponentsDemo from '../components/ComponentsDemo.astro';
import FlavorDemo from '../components/FlavorDemo.astro';
import GlazingDemo from '../components/GlazingDemo.astro';
import Inscription from '../components/Inscription.astro';
import LightDemo from '../components/LightDemo.astro';
import NamedWindows from '../components/NamedWindows.astro';
import Pigments from '../components/Pigments.astro';
import PlaygroundSection from '../components/PlaygroundSection.astro';
import Toast from '../components/Toast.astro';
import WindowDemo from '../components/WindowDemo.astro';
import { toRoman } from '../data/numerals';

const sections = [
  {
    id: 'flavors',
    name: 'Flavors',
    title: 'The same building, four hours of light',
    intro:
      'A flavor is the canonical hour at which you stand in the nave. Stone, ink and shadow change with it; every pigment is re-toned so it stays legible. Each card is themed on its own, nested inside this page.',
  },
  {
    id: 'pigments',
    name: 'Pigments',
    title: 'Every glass, every tone',
    intro:
      'Pigments are flavor-independent ramps generated in OKLCH, so a tone number means the same lightness in every hue. The outlined tone is the one the current flavor uses as that glass. Pick a name to make it the accent; pick any tone or role to copy its hex.',
  },
  {
    id: 'glazing',
    name: 'Glazing',
    title: 'One accent, three ways of holding colour',
    intro:
      'Glazing decides how the accent is rendered on a filled element. It is a separate axis from the accent itself, so any pigment works in any glazing.',
  },
  {
    id: 'windows',
    name: 'Windows',
    title: 'Light that is cast, not applied',
    intro:
      'The window colours ambient light (beams, glows, hero gradients) while the accent keeps doing the precise work. It always follows the accent: alone, or leaded with its two neighbours on the hue wheel.',
  },
  {
    id: 'components',
    name: 'Components',
    title: 'What the tokens feel like in use',
    intro: 'Plain HTML and CSS reading only Sanctuary custom properties. This is a preview of the future component library, not the library itself.',
  },
  {
    id: 'light',
    name: 'Light',
    title: 'Lumen: elevation is illumination',
    intro:
      'In a dark building, what is nearer to you is not only shadowed from behind, it is better lit. Each Lumen level pairs a lighter stone with a deeper umbra; at level 5 only the umbra deepens. Cast is the separate, coloured glow that glass throws on its surroundings.',
  },
];
// The same sections, keyed by id and numbered, for rendering each one below.
const byId = Object.fromEntries(sections.map((entry, index) => [entry.id, { ...entry, number: index + 1 }]));
---

<Base title="Playground · Sanctuary" description="Every axis of Sanctuary live: flavors, pigments, glazing, windows, components and light.">
  <main>
    <header class="intro">
      <Inscription>Every axis, live</Inscription>
      <h1>Playground</h1>
      <p>Change the light in the lectern above, or pick a value below. Every section follows it.</p>
      <nav class="index" aria-label="Playground sections">
        <ol>
          {
            sections.map(({ id, name }, index) => (
              <li>
                <a href={`#${id}`}>
                  <span>{toRoman(index + 1)}</span> {name}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    <PlaygroundSection {...byId.flavors}>
      <FlavorDemo layout="row" />
    </PlaygroundSection>

    <PlaygroundSection {...byId.pigments}>
      <Pigments />
    </PlaygroundSection>

    <PlaygroundSection {...byId.glazing}>
      <GlazingDemo />
    </PlaygroundSection>

    <PlaygroundSection {...byId.windows}>
      <WindowDemo />
      <h3 class="sub">Named windows</h3>
      <p class="note">Five fixed gradients for a single place, such as a cover or an illustration. They do not follow the accent and are not a theme switch.</p>
      <NamedWindows />
    </PlaygroundSection>

    <PlaygroundSection {...byId.components}>
      <ComponentsDemo />
    </PlaygroundSection>

    <PlaygroundSection {...byId.light}>
      <LightDemo />
    </PlaygroundSection>
  </main>
  <Toast />
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--san-space-4);
    max-width: 82rem;
    margin: 0 auto;
    padding: var(--san-space-16) clamp(var(--san-space-4), 4vw, var(--san-space-12)) var(--san-space-12);
  }
  h1 { margin: 0; font: var(--san-type-display-md); letter-spacing: var(--san-type-display-md-tracking); }
  .intro > p { margin: 0; max-width: var(--san-size-measure); font: var(--san-type-body-lg); color: var(--san-text-muted); }

  .index ol { display: flex; flex-wrap: wrap; gap: var(--san-space-2); margin: var(--san-space-4) 0 0; padding: 0; list-style: none; }
  .index a {
    display: inline-flex;
    align-items: center;
    gap: var(--san-space-2);
    height: var(--san-size-control-sm);
    padding: 0 var(--san-space-3);
    border: var(--san-border-width-hairline) solid var(--san-lead);
    border-radius: var(--san-radius-full);
    color: var(--san-text);
    font: var(--san-type-label-lg);
    text-decoration: none;
  }
  .index a:hover { border-color: var(--san-accent); color: var(--san-accent-ink); }
  .index a:focus-visible { outline: none; box-shadow: var(--san-halo); }
  .index span { font: var(--san-type-inscription); letter-spacing: var(--san-type-inscription-tracking); color: var(--san-accent-ink); }

  .sub { margin: var(--san-space-12) 0 var(--san-space-3); font: var(--san-type-headline-sm); }
  .note { max-width: var(--san-size-measure); margin: 0 0 var(--san-space-6); color: var(--san-text-muted); }
</style>
