---
// Every page renders inside this layout, so the core stylesheet loads once for
// the whole site.
import '@sanctuary-ds/tokens/css';
import '../styles/global.css';
import { Font } from 'astro:assets';
import { fontBridge, fontRoles } from '../data/fonts';
import { schemeStyles } from '../data/schemes';
import Lectern from '../components/Lectern.astro';
import { STORAGE_KEY, defaultTheme, flavorAccents, options } from '../data/theme';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = Astro.currentLocale;
// One URL per page for search engines: a theme preview (?flavor=lauds) is the
// same page, so the canonical URL drops the query.
const canonical = new URL(Astro.url.pathname, Astro.site);
// One social card for every page: link previews (LinkedIn, Slack, X) need an absolute URL.
const socialImage = new URL('/og-image.png', Astro.site);
const socialImageAlt =
  'The Sanctuary rose window, twelve pigments of stained glass, beside the words: a design system of stone, glass and light';
---

<!doctype html>
<html
  lang={lang}
  data-san-flavor={defaultTheme.flavor}
  data-san-accent={defaultTheme.accent}
  data-san-glazing={defaultTheme.glazing}
  data-san-window={defaultTheme.window}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Restores the theme before the first paint, so a returning visitor never sees
      the default theme flash first. A query string such as ?flavor=lauds wins and
      previews a look without replacing the visitor's saved choice.
    -->
    <script is:inline define:vars={{ STORAGE_KEY, defaultTheme, flavorAccents, options }}>
      let saved = {};
      try {
        saved = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
      } catch {
        // Storage is unavailable or corrupt: keep the defaults.
      }
      const query = new URLSearchParams(location.search);
      const pick = (axis, fallback) =>
        [query.get(axis), saved[axis], fallback].find((value) => options[axis].includes(value));
      const flavor = pick('flavor', defaultTheme.flavor);
      const theme = {
        flavor,
        accent: pick('accent', flavorAccents[flavor]),
        glazing: pick('glazing', defaultTheme.glazing),
        window: pick('window', defaultTheme.window),
      };
      for (const axis in theme) document.documentElement.setAttribute(`data-san-${axis}`, theme[axis]);
    </script>
    {fontRoles.map(({ cssVariable, preload }) => <Font cssVariable={cssVariable} preload={preload} />)}
    <style is:inline set:html={fontBridge + schemeStyles}></style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sanctuary" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <!-- The brand rose, the organization's profile picture. favicon.ico in public/ serves clients that ask for it on their own. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <Lectern />
    <slot />
  </body>
</html>
