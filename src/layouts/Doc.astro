---
// A documentation page: the text, and the index of every page beside it. The
// index comes after the text in the document, so on a phone the page opens on
// what was asked for; on wider screens it sits in the left column.
import Base from './Base.astro';
import Inscription from '../components/Inscription.astro';
import { docHref, docsBySection } from '../data/docs';

interface Props {
  title: string;
  description: string;
  /** The carved overline above the title: the page's section. */
  inscription: string;
}

const { title, description, inscription } = Astro.props;
const sections = await docsBySection();
const here = Astro.url.pathname.replace(/\/$/, '');
const current = (href: string) => (href === here ? 'page' : undefined);
---

<Base title={`${title} · Sanctuary docs`} description={description}>
  <div class="docs">
    <main class="docs__main" data-pagefind-body>
      <header class="docs__head">
        <Inscription>{inscription}</Inscription>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <article class="prose">
        <slot />
      </article>
    </main>

    <nav class="docs__nav" aria-label="Documentation">
      <a href="/docs" aria-current={current('/docs')}>Overview</a>
      {
        sections.map((section) => (
          <section aria-labelledby={`docs-nav-${section.id}`}>
            <h2 id={`docs-nav-${section.id}`}>{section.name}</h2>
            <ul>
              {section.docs.map((doc) => (
                <li>
                  <a href={docHref(doc)} aria-current={current(docHref(doc))}>
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </nav>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    grid-template-areas: 'nav main';
    gap: var(--san-space-12);
    max-width: 82rem;
    margin: 0 auto;
    padding: var(--san-space-12) clamp(var(--san-space-4), 4vw, var(--san-space-12)) var(--san-space-16);
  }
  .docs__main { grid-area: main; min-width: 0; }
  .docs__nav { grid-area: nav; align-self: start; display: grid; gap: var(--san-space-6); }

  .docs__head { display: grid; gap: var(--san-space-4); max-width: var(--san-size-measure); margin-bottom: var(--san-space-10); }
  h1 { margin: 0; font: var(--san-type-display-sm); letter-spacing: var(--san-type-display-sm-tracking); }
  .docs__head p { margin: 0; font: var(--san-type-body-lg); color: var(--san-text-muted); }

  .docs__nav h2 { margin: 0 0 var(--san-space-2); font: var(--san-type-inscription); letter-spacing: var(--san-type-inscription-tracking); text-transform: uppercase; color: var(--san-text-subtle); }
  .docs__nav ul { display: grid; gap: var(--san-space-1); margin: 0; padding: 0; list-style: none; }
  .docs__nav a {
    display: block;
    padding: var(--san-space-1) var(--san-space-3);
    border-left: var(--san-border-width-came) solid var(--san-lead-soft);
    color: var(--san-text-muted);
    font: var(--san-type-label-lg);
    text-decoration: none;
  }
  .docs__nav a:hover { color: var(--san-accent-ink); }
  .docs__nav a[aria-current='page'] { border-left-color: var(--san-accent); color: var(--san-text); }
  .docs__nav a:focus-visible { outline: none; border-radius: var(--san-radius-xs); box-shadow: var(--san-halo); }

  /* The text comes from Markdown, so its elements are reached through :global.
     Lists the page builds itself carry a class and keep their own layout. */
  /* Running text keeps the reading measure; generated tables, which carry a
     class, may use the whole column. */
  .prose :global(:is(p, ul, ol, pre, h2, h3, table:not([class]))) { max-width: var(--san-size-measure); }
  .prose :global(:is(h2, h3)) { margin: var(--san-space-12) 0 var(--san-space-4); }
  .prose :global(h2) { font: var(--san-type-headline-sm); letter-spacing: var(--san-type-headline-sm-tracking); }
  .prose :global(h3) { font: var(--san-type-title-lg); }
  .prose :global(:is(p, ul, ol, table, pre)) { margin: 0 0 var(--san-space-4); }
  .prose :global(:is(ul, ol):not([class])) { padding-left: var(--san-space-6); }
  .prose :global(:is(ul, ol):not([class]) > li + li) { margin-top: var(--san-space-2); }
  .prose :global(a) { color: var(--san-accent-ink); }
  .prose :global(a:focus-visible) { outline: none; border-radius: var(--san-radius-xs); box-shadow: var(--san-halo); }
  .prose :global(code) { font: var(--san-type-code-md); }
  .prose :global(:not(pre) > code) { padding: 0 var(--san-space-1); border-radius: var(--san-radius-xs); background: var(--san-surface-sunken); }
  /* Long lines wrap instead of scrolling, so every line can be read without a
     scrolling box that a keyboard would first need to focus. */
  .prose :global(pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: var(--san-space-4);
    border: var(--san-border-width-hairline) solid var(--san-lead-soft);
    border-left: var(--san-border-width-heavy) solid var(--san-accent);
    border-radius: var(--san-radius-sm);
    background: var(--san-surface-sunken);
  }
  .prose :global(table) { border-collapse: collapse; }
  .prose :global(table:not([class])) { display: block; overflow-x: auto; }
  .prose :global(:is(th, td)) { padding: var(--san-space-2) var(--san-space-4); border-bottom: var(--san-border-width-hairline) solid var(--san-lead-soft); text-align: left; vertical-align: top; }
  .prose :global(th) { font: var(--san-type-label-lg); }
  .prose :global(td:first-child code) { white-space: nowrap; }

  @media (max-width: 48rem) {
    .docs { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'main' 'nav'; }
    .docs__nav { padding-top: var(--san-space-8); border-top: var(--san-border-width-hairline) solid var(--san-lead-soft); }
  }
</style>
