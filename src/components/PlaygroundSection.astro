---
// One numbered section of the playground, with the showcase's head.
import { toRoman } from '../data/numerals';
import SectionHead from './SectionHead.astro';

interface Props {
  id: string;
  number: number;
  name: string;
  title: string;
  intro: string;
}

const { id, number, name, title, intro } = Astro.props;
---

<section class="playground-section" id={id} aria-labelledby={`${id}-title`}>
  <SectionHead inscription={`${toRoman(number)} · ${name}`} title={title} id={`${id}-title`} class="playground-section__head">{intro}</SectionHead>
  <slot />
</section>

<style>
  .playground-section {
    max-width: 82rem;
    margin: 0 auto;
    padding: var(--san-space-20) clamp(var(--san-space-4), 4vw, var(--san-space-12));
    border-top: var(--san-border-width-hairline) solid var(--san-lead-soft);
    scroll-margin-top: var(--san-space-24);
  }
  .playground-section > :global(.playground-section__head) { margin-bottom: var(--san-space-10); }
</style>
