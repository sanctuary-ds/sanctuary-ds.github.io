---
// One step of the nave: a key idea beside its live demo. Steps alternate sides,
// and each links to its playground section once the playground exists.
import SectionHead from './SectionHead.astro';

interface Props {
  inscription: string;
  title: string;
  id?: string;
  flip?: boolean;
  more?: { href: string; label: string };
}

const { inscription, title, id, flip = false, more } = Astro.props;
---

<section class:list={['step', { 'step--flip': flip }]} id={id}>
  <div class="step__copy">
    <SectionHead inscription={inscription} title={title}><slot /></SectionHead>
    {more && <a class="step__more" href={more.href}>{more.label}</a>}
  </div>
  <div class="step__demo"><slot name="demo" /></div>
</section>

<style>
  .step {
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--san-space-16);
    max-width: 82rem;
    margin: 0 auto;
    padding: var(--san-space-20) clamp(var(--san-space-4), 4vw, var(--san-space-12));
    border-top: var(--san-border-width-hairline) solid var(--san-lead-soft);
  }
  .step--flip { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); }
  .step--flip .step__copy { order: 2; }

  .step__more {
    display: inline-flex;
    margin-top: var(--san-space-6);
    font: var(--san-type-label-lg);
    letter-spacing: var(--san-type-label-lg-tracking);
    color: var(--san-accent-ink);
    text-decoration: none;
  }
  .step__more::after { content: '→'; margin-inline-start: var(--san-space-2); }

  @media (max-width: 64rem) {
    .step,
    .step--flip { grid-template-columns: 1fr; gap: var(--san-space-8); }
    .step--flip .step__copy { order: 0; }
  }
</style>
