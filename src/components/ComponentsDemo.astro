---
// The showcase's component panels: plain HTML and CSS reading only core tokens,
// a preview of the future component library rather than the library itself.
// The tabs work (src/scripts/tabs.ts); the form controls are live but submit
// nowhere.
import Button from './Button.astro';
import Inscription from './Inscription.astro';
import Lancet from './Lancet.astro';

const places = [
  { id: 'nave', name: 'Nave', text: 'Where the people stand, under the clerestory.' },
  { id: 'transept', name: 'Transept', text: 'The arms of the cross, each ending in a rose.' },
  { id: 'choir', name: 'Choir', text: 'Where the hours are sung, behind the screen.' },
  { id: 'crypt', name: 'Crypt', text: 'Stone under stone, lit by a single lamp.' },
];
const statuses = [
  { status: 'info', label: 'Notice', alert: 'Vespers begins at dusk.' },
  { status: 'success', label: 'Done', alert: 'The window was leaded and set.' },
  { status: 'warning', label: 'Careful', alert: 'Silver stain darkens when over-fired.' },
  { status: 'danger', label: 'Failed', alert: 'A pane cracked in the kiln.' },
];
const chips = [
  { status: 'success', label: 'Consecrated' },
  { status: 'warning', label: 'Vigil' },
  { status: 'danger', label: 'Profaned' },
  { status: 'info', label: 'Notice' },
];
---

<div class="components">
  <article class="panel">
    <h3 class="panel__title">Buttons</h3>
    <div class="row">
      <Button variant="glazed">Glazed</Button>
      <Button variant="pane">Pane</Button>
      <Button variant="outline">Outline</Button>
      <Button variant="ghost">Ghost</Button>
    </div>
    <div class="row">
      <Button size="sm">Small</Button>
      <Button size="lg">Large</Button>
      <Button disabled>Disabled</Button>
      <Button variant="danger">Destroy</Button>
    </div>
    <h3 class="panel__title">Chips</h3>
    <div class="row">
      <span class="chip chip--glazed">Accent</span>
      <span class="chip">Neutral</span>
      {chips.map(({ status, label }) => <span class="chip chip--status" data-status={status}>{label}</span>)}
    </div>
  </article>

  <article class="panel">
    <h3 class="panel__title">Form</h3>
    <label class="field">
      <span class="field__label">Name of the chapel</span>
      <input class="field__input" type="text" value="Sainte-Chapelle" spellcheck="false" />
      <span class="field__hint">Shown on every window you glaze.</span>
    </label>
    <label class="field">
      <span class="field__label">Order</span>
      <select class="field__input">
        <option>Cistercian</option>
        <option>Benedictine</option>
        <option>Carthusian</option>
      </select>
    </label>
    <div class="row row--spread">
      <label class="check"><input type="checkbox" checked /><span>Ring the bells</span></label>
      <label class="check"><input type="radio" name="components-place" checked /><span>Nave</span></label>
      <label class="check"><input type="radio" name="components-place" /><span>Choir</span></label>
      <label class="switch"><input type="checkbox" role="switch" checked /><span class="switch__track"></span><span>Candles</span></label>
    </div>
    <label class="field">
      <span class="field__label">Light through the west window</span>
      <input class="range" type="range" min="0" max="100" value="64" />
    </label>
  </article>

  <article class="panel">
    <h3 class="panel__title">Navigation</h3>
    <div class="tabs" role="tablist" aria-label="Parts of the church">
      {
        places.map(({ id, name }, index) => (
          <button class="tab" type="button" role="tab" id={`tab-${id}`} aria-controls={`tabpanel-${id}`} aria-selected={String(index === 0)} tabindex={index === 0 ? 0 : -1}>
            {name}
          </button>
        ))
      }
    </div>
    {
      places.map(({ id, text }, index) => (
        <p class="tabpanel" role="tabpanel" id={`tabpanel-${id}`} aria-labelledby={`tab-${id}`} hidden={index !== 0}>
          {text}
        </p>
      ))
    }
    <ul class="menu">
      <li class="menu__item" aria-current="true"><span class="menu__dot"></span>Rose window<kbd>R</kbd></li>
      <li class="menu__item"><span class="menu__dot"></span>Clerestory<kbd>C</kbd></li>
      <li class="menu__item"><span class="menu__dot"></span>Ambulatory<kbd>A</kbd></li>
    </ul>
    <h3 class="panel__title">Progress</h3>
    <div class="progress" role="progressbar" aria-label="Glazing the north transept" aria-valuenow="64" aria-valuemin="0" aria-valuemax="100">
      <span style="width: 64%"></span>
    </div>
    <p class="caption">Glazing the north transept: 64%</p>
  </article>

  <article class="panel">
    <h3 class="panel__title">Status</h3>
    {
      statuses.map(({ status, label, alert }) => (
        <div class="alert" data-status={status}>
          <strong>{label}.</strong> {alert}
        </div>
      ))
    }
  </article>

  <article class="card">
    <div class="card__window"><Lancet /></div>
    <div class="card__body">
      <Inscription>Lancet card</Inscription>
      <h3>North rose, restored</h3>
      <p>The arch is a token: <code>--san-shape-lancet</code>. Media, avatars and badges can wear it.</p>
      <div class="row">
        <Button size="sm">Visit</Button>
        <Button variant="ghost" size="sm">Later</Button>
      </div>
    </div>
  </article>

  <article class="dialog">
    <Inscription>Dialog</Inscription>
    <h3>Extinguish the candles?</h3>
    <p>The nave will fall back to Matins. You can light them again at any hour.</p>
    <div class="row row--end">
      <Button variant="ghost">Keep them</Button>
      <Button>Extinguish</Button>
    </div>
    <div class="avatars">
      <span class="avatar">AB</span>
      <span class="avatar" data-san-accent="ruby">HL</span>
      <span class="avatar" data-san-accent="gilt">SG</span>
      <span class="tooltip">Each avatar sets its own accent</span>
    </div>
  </article>
</div>

<script>
  import { initTabs } from '../scripts/tabs';
  initTabs();
</script>

<style>
  .components { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--san-space-6); align-items: start; }

  .panel {
    display: grid;
    gap: var(--san-space-4);
    padding: var(--san-space-6);
    border: var(--san-border-width-hairline) solid var(--san-lead-soft);
    border-radius: var(--san-radius-md);
    background: var(--san-surface-raised-1);
  }
  .panel__title { margin: 0; font: var(--san-type-inscription); letter-spacing: var(--san-type-inscription-tracking); text-transform: uppercase; color: var(--san-text-subtle); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--san-space-2); }
  .row--spread { justify-content: space-between; }
  .row--end { justify-content: flex-end; }
  .caption { margin: 0; font: var(--san-type-body-sm); color: var(--san-text-subtle); }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--san-space-2);
    height: 1.75rem;
    padding: 0 var(--san-space-3);
    border: var(--san-border-width-hairline) solid var(--san-lead);
    border-radius: var(--san-radius-full);
    background: var(--san-surface-raised-2);
    color: var(--san-text-muted);
    font: var(--san-type-label-md);
    letter-spacing: var(--san-type-label-md-tracking);
  }
  .chip--glazed {
    border-color: var(--san-glaze-border);
    background: var(--san-glaze-sheen), var(--san-glaze-bg);
    color: var(--san-glaze-fg);
    box-shadow: var(--san-glaze-glow);
    backdrop-filter: var(--san-glaze-blur);
  }

  /* One status, four colours: each status names its own, and the chip and the
     alert read them through --st*. */
  [data-status='info'] { --st: var(--san-info); --st-pane: var(--san-info-pane); --st-on-pane: var(--san-info-on-pane); --st-ink: var(--san-info-ink); }
  [data-status='success'] { --st: var(--san-success); --st-pane: var(--san-success-pane); --st-on-pane: var(--san-success-on-pane); --st-ink: var(--san-success-ink); }
  [data-status='warning'] { --st: var(--san-warning); --st-pane: var(--san-warning-pane); --st-on-pane: var(--san-warning-on-pane); --st-ink: var(--san-warning-ink); }
  [data-status='danger'] { --st: var(--san-danger); --st-pane: var(--san-danger-pane); --st-on-pane: var(--san-danger-on-pane); --st-ink: var(--san-danger-ink); }
  .chip--status { border-color: transparent; background: var(--st-pane); color: var(--st-on-pane); }
  .chip--status::before { content: ''; width: 0.4rem; height: 0.4rem; rotate: 45deg; background: var(--st); }

  .field { display: grid; gap: var(--san-space-1); }
  .field__label { font: var(--san-type-label-lg); color: var(--san-text-muted); }
  .field__hint { font: var(--san-type-body-sm); color: var(--san-text-subtle); }
  .field__input {
    height: var(--san-size-control-md);
    padding: 0 var(--san-space-3);
    border: var(--san-border-width-hairline) solid var(--san-lead);
    border-bottom: var(--san-border-width-came) solid var(--san-lead-strong);
    border-radius: var(--san-radius-sm);
    background: var(--san-surface-sunken);
    color: var(--san-text);
    font: var(--san-type-body-md);
  }
  .field__input:hover { border-color: var(--san-lead-strong); }
  .field__input:focus { outline: none; border-color: var(--san-accent); box-shadow: var(--san-cast-sm); }

  .check, .switch { display: inline-flex; align-items: center; gap: var(--san-space-2); font: var(--san-type-body-sm); cursor: pointer; }
  .check input, .range { accent-color: var(--san-accent); }
  .check input { width: 1.05rem; height: 1.05rem; margin: 0; }
  .range { width: 100%; }

  .switch { position: relative; }
  .switch input { position: absolute; opacity: 0; }
  .switch__track {
    position: relative;
    width: 2.5rem;
    height: 1.375rem;
    border: var(--san-border-width-hairline) solid var(--san-lead-strong);
    border-radius: var(--san-radius-full);
    background: var(--san-surface-sunken);
  }
  .switch__track::after {
    content: '';
    position: absolute;
    inset: 2px auto 2px 2px;
    aspect-ratio: 1;
    border-radius: var(--san-radius-full);
    background: var(--san-text-subtle);
  }
  .switch input:checked + .switch__track { border-color: var(--san-glaze-border); background: var(--san-glaze-sheen), var(--san-glaze-bg); box-shadow: var(--san-cast-sm); }
  .switch input:checked + .switch__track::after { translate: 1.125rem 0; background: var(--san-glaze-fg); }
  .switch input:focus-visible + .switch__track { box-shadow: var(--san-halo); }

  .tabs { display: flex; flex-wrap: wrap; gap: var(--san-space-1); border-bottom: var(--san-border-width-hairline) solid var(--san-lead); }
  .tab {
    margin-bottom: -1px;
    padding: var(--san-space-2) var(--san-space-3);
    border: 0;
    border-bottom: var(--san-border-width-came) solid transparent;
    background: none;
    color: var(--san-text-muted);
    font: var(--san-type-label-lg);
    cursor: pointer;
  }
  .tab:hover { color: var(--san-text); }
  .tab:focus-visible { outline: none; box-shadow: var(--san-halo); }
  .tab[aria-selected='true'] { border-color: var(--san-accent); color: var(--san-accent-ink); box-shadow: 0 10px 14px -12px var(--san-accent); }
  .tabpanel { margin: 0; font: var(--san-type-body-sm); color: var(--san-text-muted); }

  .menu { display: grid; gap: var(--san-space-half); margin: 0; padding: 0; list-style: none; }
  .menu__item {
    display: flex;
    align-items: center;
    gap: var(--san-space-3);
    padding: var(--san-space-2) var(--san-space-3);
    border-radius: var(--san-radius-sm);
    color: var(--san-text-muted);
    font: var(--san-type-body-sm);
  }
  .menu__item:hover { background: var(--san-surface-raised-3); color: var(--san-text); }
  .menu__item[aria-current='true'] { background: var(--san-accent-pane); color: var(--san-accent-on-pane); }
  .menu__item kbd { margin-left: auto; font: var(--san-type-code-sm); }
  .menu__dot { width: 0.4rem; height: 0.4rem; rotate: 45deg; background: var(--san-lead-strong); }
  .menu__item[aria-current='true'] .menu__dot { background: var(--san-accent-lume); box-shadow: 0 0 8px var(--san-accent); }

  .progress { height: 0.625rem; padding: 1px; border: var(--san-border-width-hairline) solid var(--san-lead); border-radius: var(--san-radius-full); background: var(--san-surface-sunken); }
  .progress span { display: block; height: 100%; border-radius: inherit; background: var(--san-window); box-shadow: var(--san-cast-sm); }

  .alert {
    padding: var(--san-space-3) var(--san-space-4);
    border: var(--san-border-width-hairline) solid color-mix(in oklch, var(--st) 35%, transparent);
    border-left: var(--san-border-width-heavy) solid var(--st);
    border-radius: var(--san-radius-sm);
    background: color-mix(in oklch, var(--st-pane) 45%, var(--san-surface-raised-1));
    font: var(--san-type-body-sm);
  }
  .alert strong { color: var(--st-ink); }

  .card {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    overflow: hidden;
    border: var(--san-border-width-hairline) solid var(--san-lead);
    border-radius: var(--san-radius-md);
    background: var(--san-surface-raised-2);
    box-shadow: var(--san-elevation-2);
  }
  .card__window { display: grid; place-items: end center; padding: var(--san-space-5) var(--san-space-4) 0; background: var(--san-surface-sunken); }
  .card__window > :global(.glow) { min-height: 11rem; }
  .card__body { display: grid; align-content: center; gap: var(--san-space-3); padding: var(--san-space-6); }
  .card__body h3, .dialog h3 { margin: 0; font: var(--san-type-title-lg); }
  .card__body p, .dialog > p { margin: 0; font: var(--san-type-body-sm); color: var(--san-text-muted); }

  .dialog {
    display: grid;
    align-content: start;
    gap: var(--san-space-3);
    padding: var(--san-space-6);
    border: var(--san-border-width-hairline) solid var(--san-lead);
    border-radius: var(--san-radius-lg);
    background: var(--san-surface-raised-3);
    box-shadow: var(--san-elevation-4);
  }

  .avatars { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--san-space-2); margin-top: var(--san-space-2); padding-top: var(--san-space-4); border-top: var(--san-border-width-hairline) solid var(--san-lead); }
  .avatar {
    display: grid;
    place-items: end center;
    width: 2.5rem;
    height: 3.25rem;
    padding-bottom: var(--san-space-2);
    clip-path: var(--san-shape-ogive);
    background: var(--san-accent);
    color: var(--san-accent-on);
    font: var(--san-type-label-md);
  }
  .tooltip {
    margin-left: var(--san-space-2);
    padding: var(--san-space-1) var(--san-space-2);
    border-radius: var(--san-radius-xs);
    background: var(--san-surface-inverse);
    color: var(--san-text-inverse);
    font: var(--san-type-label-md);
  }

  @media (prefers-reduced-motion: no-preference) {
    .field__input, .tab, .switch__track, .switch__track::after { transition: all var(--san-duration-base) var(--san-ease-standard); }
  }

  @media (max-width: 30rem) {
    .card { grid-template-columns: 1fr; }
    .card__window > :global(.glow) { width: 7rem; min-height: 9rem; }
  }
</style>
