---
// The systemic layer, as the showcase shows it: type, shape, lead, space and
// motion, each sample drawn with the token it names. Play runs the motion
// tracks one way and back.
const type = [
  ['display-lg', 'Lux aeterna'],
  ['display-sm', 'Light through glass'],
  ['headline-md', 'The nave at dusk'],
  ['title-lg', 'Title large, for cards and dialogs'],
  ['body-lg', 'Body large. Stone is quiet so that color can speak.'],
  ['body-md', 'Body medium, the default running text of the system.'],
  ['label-lg', 'Label large · buttons and tabs'],
  ['inscription', 'Inscription · carved overlines'],
  ['code-md', 'const glass = pigment.cobalt[300];'],
];
const radii = ['none', 'xs', 'sm', 'md', 'lg', 'xl', 'full'];
const arches = ['lancet', 'ogive'];
const leads = [
  { width: 'hairline', color: 'lead' },
  { width: 'came', color: 'lead-strong' },
  { width: 'heavy', color: 'lead-came' },
];
const spaces = ['1', '2', '3', '4', '6', '8', '12', '16'];
const motions = [
  ['standard', 'slow'],
  ['enter', 'slow'],
  ['exit', 'slow'],
  ['standard', 'procession'],
];
---

<div class="foundations">
  <article class="panel panel--wide">
    <h3 class="panel__title">Type scale</h3>
    <div class="specimen">
      {
        type.map(([role, sample]) => (
          <div class="specimen__row">
            <code>{role}</code>
            <span style={`font: var(--san-type-${role}); letter-spacing: var(--san-type-${role}-tracking)`} class:list={[role === 'inscription' && 'is-inscription']}>
              {sample}
            </span>
          </div>
        ))
      }
    </div>
  </article>

  <article class="panel">
    <h3 class="panel__title">Shape</h3>
    <div class="shapes">
      {radii.map((radius) => <div class="shape" style={`border-radius: var(--san-radius-${radius})`}><span>{radius}</span></div>)}
      {arches.map((arch) => <div class="shape shape--arch" style={`clip-path: var(--san-shape-${arch})`}><span>{arch}</span></div>)}
    </div>
    <h3 class="panel__title">Lead</h3>
    <div class="leads">
      {leads.map(({ width, color }) => <div style={`border-top: var(--san-border-width-${width}) solid var(--san-${color})`}><span>{width}</span></div>)}
    </div>
  </article>

  <article class="panel">
    <h3 class="panel__title">Space</h3>
    <div class="spaces">
      {
        spaces.map((step) => (
          <div class="space">
            <code>{step}</code>
            <i style={`width: var(--san-space-${step})`} />
          </div>
        ))
      }
    </div>
  </article>

  <article class="panel panel--wide">
    <h3 class="panel__title panel__title--action">
      Motion
      <button class="play" type="button" aria-pressed="false">Play</button>
    </h3>
    <div class="motions">
      {
        motions.map(([ease, duration]) => (
          <div class="motion">
            <code>
              ease-{ease} · {duration}
            </code>
            <div class="motion__track">
              <i style={`transition: translate var(--san-duration-${duration}) var(--san-ease-${ease})`} />
            </div>
          </div>
        ))
      }
    </div>
  </article>
</div>

<script>
  // Each press sends the markers to the other end of their tracks.
  for (const play of document.querySelectorAll<HTMLButtonElement>('.foundations .play')) {
    play.addEventListener('click', () => {
      const played = play.getAttribute('aria-pressed') !== 'true';
      play.setAttribute('aria-pressed', String(played));
      for (const track of play.closest('.panel')!.querySelectorAll('.motion__track')) track.classList.toggle('is-played', played);
    });
  }
</script>

<style>
  .foundations { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--san-space-6); align-items: start; }
  .panel {
    display: grid;
    gap: var(--san-space-4);
    min-width: 0;
    padding: var(--san-space-6);
    border: var(--san-border-width-hairline) solid var(--san-lead-soft);
    border-radius: var(--san-radius-md);
    background: var(--san-surface-raised-1);
  }
  .panel--wide { grid-column: 1 / -1; }
  .panel__title { margin: 0; font: var(--san-type-inscription); letter-spacing: var(--san-type-inscription-tracking); text-transform: uppercase; color: var(--san-text-subtle); }
  .panel__title--action { display: flex; align-items: center; justify-content: space-between; }
  code { font: var(--san-type-code-sm); color: var(--san-text-subtle); }

  .specimen__row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--san-space-4);
    padding: var(--san-space-3) 0;
    border-bottom: var(--san-border-width-hairline) solid var(--san-lead-soft);
  }
  .specimen__row span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .is-inscription { text-transform: uppercase; color: var(--san-accent-ink); }

  .shapes { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--san-space-3); }
  .shape {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: var(--san-border-width-hairline) solid var(--san-accent);
    background: var(--san-accent-pane);
    color: var(--san-accent-on-pane);
    font: var(--san-type-label-sm);
  }
  .shape--arch { height: 5rem; place-items: end center; padding-bottom: var(--san-space-2); border: 0; background: var(--san-window); color: var(--san-accent-on); }

  .leads { display: grid; gap: var(--san-space-4); }
  .leads span { font: var(--san-type-code-sm); color: var(--san-text-subtle); }

  .spaces { display: grid; gap: var(--san-space-2); }
  .space { display: grid; grid-template-columns: 2rem 1fr; align-items: center; gap: var(--san-space-3); }
  .space i { height: 0.75rem; border-radius: var(--san-radius-xs); background: var(--san-accent); }

  .play {
    height: var(--san-size-control-sm);
    padding: 0 var(--san-space-3);
    border: 0;
    border-radius: var(--san-radius-sm);
    background: var(--san-accent-pane);
    color: var(--san-accent-on-pane);
    font: var(--san-type-label-md);
    letter-spacing: normal;
    text-transform: none;
    cursor: pointer;
  }
  .play:focus-visible { outline: none; box-shadow: var(--san-halo); }

  .motions { display: grid; gap: var(--san-space-4); }
  .motion { display: grid; grid-template-columns: 14rem minmax(0, 1fr); align-items: center; gap: var(--san-space-4); }
  .motion__track { container-type: inline-size; height: 1.25rem; border-radius: var(--san-radius-full); background: var(--san-surface-sunken); }
  .motion__track i { display: block; width: 1.25rem; height: 1.25rem; rotate: 45deg; scale: 0.7; background: var(--san-accent); box-shadow: var(--san-cast-sm); }
  .motion__track.is-played i { translate: calc(100cqw - 1.25rem) 0; }

  @media (max-width: 48rem) {
    .foundations { grid-template-columns: minmax(0, 1fr); }
    .specimen__row, .motion { grid-template-columns: 1fr; gap: var(--san-space-1); }
  }
</style>
